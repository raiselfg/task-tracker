APP_ENV=development

# Local infrastructure (docker-compose.local.yml).
LOCAL_POSTGRES_USER=auth
LOCAL_POSTGRES_PASSWORD=auth
LOCAL_POSTGRES_DB=auth
LOCAL_POSTGRES_PORT=5432

# Application connection strings for the local services above.
DATABASE_URL=postgresql://${LOCAL_POSTGRES_USER}:${LOCAL_POSTGRES_PASSWORD}@localhost:${LOCAL_POSTGRES_PORT}/${LOCAL_POSTGRES_DB}

ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:3001"]

SESSION_TTL_SECONDS=2592000

# Explicit opt-in for local HTTP only. Production must set this to false.
ALLOW_INSECURE_COOKIES=true

# Keep the same random secret across all API workers; generate it with secrets.token_urlsafe(32).
CSRF_SECRET=replace-with-a-random-secret-at-least-32-characters
COOKIE_SAMESITE=lax
COOKIE_PARTITIONED=false
