APP_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@DB_HOST:5432/task_tracker
ALLOWED_ORIGINS=["https://frontend.example.org"]
ALLOW_INSECURE_COOKIES=false
COOKIE_SAMESITE=none
COOKIE_PARTITIONED=true
SESSION_TTL_SECONDS=2592000

# Generate a unique value with secrets.token_urlsafe(32), then store it as a deployment secret.
# Use the same value for all workers and restarts. Do not use this placeholder.
CSRF_SECRET=replace-with-a-random-secret-at-least-32-characters
